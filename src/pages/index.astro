---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Authors from '../components/Authors.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import Divider from '../components/Divider.astro';
import { publications, byYear } from '../data/publications';

const current = byYear(publications.filter((p) => !p.archive));
const archive = byYear(publications.filter((p) => p.archive));
const archiveSpan = `${archive[archive.length - 1].year}–${archive[0].year}`;
---

<Layout title="Maks Sorokin" description="Robotics Ph.D. student at Georgia Tech working on vision-based robot learning">
  <Header current="home" />

  <!-- About Section -->
  <section id="about" class="md:min-h-screen flex items-center pt-24 md:pt-32">
    <div class="max-w-7xl mx-auto px-8 pt-4 md:pt-16 pb-24 flex flex-col items-center">
      <!-- Profile Section -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 mb-20 w-full max-w-6xl items-center">
        <!-- Left Column - Photo -->
        <div class="md:col-span-5 lg:col-span-4 flex justify-center">
          <!-- close-up on the face by default (face is 69% across, 50% down in this crop; centered by shifting 1.6 x 19%, which is also the most it can shift at 1.6x without uncovering the right edge); hover zooms out to the full view -->
          <div class="group w-full max-w-sm md:max-w-none overflow-hidden rounded-md">
            <img
              src="/assets/img/photo-alps.jpg"
              alt="Maks Sorokin"
              class="w-full scale-[1.6] -translate-x-[30%] will-change-transform transition-transform duration-[1400ms] ease-[cubic-bezier(0.45,0,0.25,1)] group-hover:delay-150 group-hover:scale-100 group-hover:translate-x-0 motion-reduce:transition-none"
            />
          </div>
        </div>

        <!-- Right Column - Info -->
        <div class="md:col-span-7 lg:col-span-8">
          <h1 class="text-4xl font-light text-gray-900 mb-6">
            Maks Sorokin
          </h1>

          <div class="text-lg text-gray-600 mb-8 leading-relaxed">
            <p class="mb-4">
              I build robot learning systems that work outside the lab, favoring minimal solutions that are easy to understand and rapid iteration over upfront sophistication. My current focus is on dynamic whole-body manipulation, with earlier work in computational robot design for manipulation and outdoor navigation.
            </p>
            <p class="mb-4">
              I received my Robotics Ph.D. at Georgia Tech, advised by
              <a href="https://www.cc.gatech.edu/~sha9/" class="link">Sehoon Ha</a>,
              in close collaboration with
              <a href="https://ckllab.stanford.edu/" class="link">C. Karen Liu</a>
              and
              <a href="https://www.linkedin.com/in/jie-tan/" class="link">Jie Tan</a>. Earlier, at Google X, I worked closely with
              <a href="https://www.yunfei-bai.com/" class="link">Yunfei Bai</a>
              and
              <a href="https://www.linkedin.com/in/khansari/" class="link">Mohi Khansari</a>.
            </p>
            <p>
              My goal is to build robot learning systems capable of learning and executing complex physical tasks with elegance, at scale, and with superhuman speed and precision, while remaining safe, reliable, and easily steerable.
            </p>
          </div>

          <!-- Links -->
          <div class="plain-links">
            <a href="https://twitter.com/initmaks">Twitter</a>
            <a href="https://scholar.google.com/citations?user=tFuFXuMAAAAJ">Google Scholar</a>
            <a href="https://linkedin.com/in/initmaks">LinkedIn</a>
            <a href="#contact" class="scroll-link">Contact</a>
          </div>
        </div>
      </div>

      <!-- Affiliations -->
      <div class="w-full max-w-6xl">
        <div class="flex flex-col md:flex-row md:justify-center space-y-6 md:space-y-0">
          <div class="flex items-start space-x-6 md:mr-24">
            <div class="flex-shrink-0 flex items-start">
              <a href="https://rai-inst.com/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity">
                <img src="/assets/icons/org/rai_square.png" alt="RAI Institute" class="h-20 w-auto max-w-24 object-contain" />
              </a>
            </div>
            <div class="min-w-0 flex-1">
              <div class="meta mb-1.5">2024 – present</div>
              <div class="font-medium text-gray-900 mb-1">Research Scientist</div>
              <a href="https://rai-inst.com/" target="_blank" rel="noopener noreferrer" class="text-gray-600 leading-snug hover:text-gray-900">RAI Institute</a>
              <div class="meta text-[10.5px] mt-1">prev. Boston Dynamics AI Institute</div>
            </div>
          </div>

          <div class="flex items-start space-x-6 md:mr-32">
            <div class="flex-shrink-0 flex items-start">
              <a href="https://everydayrobots.com/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity">
                <img src="/assets/icons/org/EverydayRobots2.gif" alt="Everyday Robots" class="h-20 w-auto max-w-24 object-contain" />
              </a>
            </div>
            <div class="min-w-0 flex-1">
              <div class="meta mb-1.5">2021 – 2022</div>
              <div class="font-medium text-gray-900 mb-1">AI Residency</div>
              <a href="https://x.company/" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Google X</a>
            </div>
          </div>

          <div class="flex items-start space-x-6">
            <div class="flex-shrink-0 flex items-start">
              <a href="https://www.gatech.edu/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity">
                <img src="/assets/icons/org/GeorgiaTech_square.png" alt="Georgia Tech" class="h-20 w-auto max-w-24 object-contain" />
              </a>
            </div>
            <div class="min-w-0 flex-1">
              <div class="meta mb-1.5">2020 – 2026</div>
              <div class="font-medium text-gray-900 mb-1">PhD in Robotics</div>
              <a href="https://www.gatech.edu/" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Georgia Tech</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlight -->
  <section id="highlight" class="pt-8 pb-12">
    <div class="max-w-6xl mx-auto px-8">
      <Divider label="recent highlight" />
      <div class="aspect-video bg-gray-100 rounded-md overflow-hidden mt-10 mb-8">
        <iframe
          class="w-full h-full"
          src="https://www.youtube.com/embed/nM_ZHzp8nQA"
          title="Combining Sampling and Learning for Dynamic Whole-Body Manipulation"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <div>
        <h3 class="text-2xl font-medium text-gray-900 leading-snug mb-3">
          <a href="https://rai-inst.com/resources/blog/combining-sampling-and-learning-for-dynamic-whole-body-manipulation/" class="hover:text-gray-600">
            Combining Sampling and Learning for Dynamic Whole-Body Manipulation
          </a>
        </h3>
        <p class="text-sm text-gray-500 mb-1.5">
          <Authors authors="Maks Sorokin*, Jan Brüdigam*, Brandon Hung*, Stephen Phillips, Dmitry Yershov, Farzad Niroui, Tong Zhao, Leonor Fermoselle, Xinghao Zhu, Chao Cao, John Z. Zhang, Duy Ta, Tao Pang, Jiuguang Wang, Simon Le Cléac'h" />
          <span class="meta">&nbsp;· *equal contribution</span>
        </p>
        <p class="meta mb-3">RAI Institute blog post, 2025</p>
        <p class="text-[15px] text-gray-700 leading-relaxed mb-3">
          We give Spot the ability to manipulate heavy objects (15kg tires) using its entire body. By combining sampling-based optimization with reinforcement learning, the system enables forceful, multi-contact manipulation that discovers strategies on the fly — handling objects that exceed the robot's nominal payload, at near-human speeds.
        </p>
        <div class="pub-links">
          <a href="https://rai-inst.com/resources/blog/combining-sampling-and-learning-for-dynamic-whole-body-manipulation/">blog post</a>
          <a href="https://www.youtube.com/watch?v=nM_ZHzp8nQA">video</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Publications Section -->
  <section id="publications" class="py-12">
    <div class="max-w-6xl mx-auto px-8 space-y-20">
      {current.map((g) => (
        <div>
          <Divider label={g.year} />
          <div class="mt-10 space-y-14">
            {g.items.map((p) => <PublicationEntry p={p} />)}
          </div>
        </div>
      ))}

      <div>
        <Divider label={`earlier projects · ${archiveSpan}`} />
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-10">
          {archive.flatMap((g) => g.items).map((p) => <ArchiveCard p={p} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="pt-12 pb-24">
    <div class="max-w-6xl mx-auto px-8">
      <Divider label="contact" />
      <div class="mt-10 grid grid-cols-1 md:grid-cols-5 gap-12">
        <div class="md:col-span-2">
          <h2 class="text-2xl font-light text-gray-900 mb-4">Get in touch</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            To get in touch please leave me a note filling this form
          </p>
          <div class="flex flex-col gap-2 plain-links">
            <a href="https://twitter.com/initmaks">Twitter</a>
            <a href="https://scholar.google.com/citations?user=tFuFXuMAAAAJ">Google Scholar</a>
            <a href="https://linkedin.com/in/initmaks">LinkedIn</a>
          </div>
        </div>

        <form id="contact-form" action="https://formspree.io/f/xrerdpdq" method="POST" class="md:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-7">
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <label class="block">
            <span class="section-label">Name</span>
            <input type="text" name="name" required autocomplete="name" class="field" />
          </label>
          <label class="block">
            <span class="section-label">Email</span>
            <input type="email" name="email" required autocomplete="email" class="field" />
          </label>
          <label class="block sm:col-span-2">
            <span class="section-label">Message</span>
            <textarea name="message" required rows="4" class="field resize-y"></textarea>
          </label>
          <div class="sm:col-span-2 flex items-center gap-5">
            <button type="submit" class="font-mono text-[12.5px] tracking-[0.04em] text-white bg-gray-900 hover:bg-accent px-5 py-2.5 rounded-md cursor-pointer transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
              send message →
            </button>
            <p id="contact-status" class="font-mono text-[12.5px] text-gray-500" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="pb-10">
    <div class="max-w-6xl mx-auto px-8">
      <div class="flex flex-wrap justify-between gap-4 border-t border-gray-200 pt-6">
        <p class="meta">© 2026 Maks Sorokin</p>
        <p class="meta">built with <a href="https://astro.build" class="hover:text-gray-600">Astro</a> &amp; <a href="https://tailwindcss.com" class="hover:text-gray-600">Tailwind</a></p>
      </div>
    </div>
  </footer>

  <!-- Fixed Scroll Indicator -->
  <button type="button" id="scroll-indicator" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-40 opacity-0 transition-opacity duration-500 text-btn" onclick="document.getElementById('highlight').scrollIntoView({behavior: 'smooth'})">
    scroll ↓
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Smooth scrolling for navigation links
      document.querySelectorAll<HTMLAnchorElement>('.scroll-link').forEach(link => {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          const targetSection = document.querySelector(this.getAttribute('href')!);
          targetSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // Highlight the nav link of the section in view
      function updateNavigation() {
        let current = '';
        document.querySelectorAll<HTMLElement>('section[id]').forEach(section => {
          const top = section.offsetTop - 100;
          if (window.scrollY >= top && window.scrollY < top + section.offsetHeight) current = section.id;
        });
        document.querySelectorAll('header .scroll-link').forEach(link => {
          link.classList.toggle('text-gray-900', link.getAttribute('href') === `#${current}`);
        });
      }

      // Scroll hint: shown on load at the top of the page, hidden on any scroll
      const scrollIndicator = document.getElementById('scroll-indicator');
      window.addEventListener('scroll', function() {
        updateNavigation();
        if (scrollIndicator) scrollIndicator.style.opacity = '0';
      });
      // (only when the about block ends above it, so it never sits on top of content)
      setTimeout(() => {
        const aboutBottom = document.querySelector('#about > div')!.getBoundingClientRect().bottom;
        if (window.scrollY < 50 && scrollIndicator && aboutBottom < window.innerHeight - 64) scrollIndicator.style.opacity = '1';
      }, 100);

      // Publication clips load and play only while on screen
      const clips = new IntersectionObserver((entries) => entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (!v.src && v.dataset.src) v.src = v.dataset.src;
          v.play().catch(() => {});
        } else v.pause();
      }), { rootMargin: '200px' });
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.querySelectorAll('#publications video[data-src]').forEach(v => clips.observe(v));

      // Contact form (AJAX submit, no redirect)
      const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
      const contactStatus = document.getElementById('contact-status');
      if (contactForm && contactStatus) {
        contactForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
          submitBtn.disabled = true;
          contactStatus.textContent = 'Sending…';
          contactStatus.className = 'font-mono text-[12.5px] text-gray-500';
          try {
            const response = await fetch(contactForm.action, {
              method: 'POST',
              body: new FormData(contactForm),
              headers: { Accept: 'application/json' }
            });
            if (response.ok) {
              contactStatus.textContent = 'Thanks — your message is on its way.';
              contactStatus.className = 'font-mono text-[12.5px] text-gray-900';
              contactForm.reset();
            } else {
              const data = await response.json().catch(() => ({}));
              throw new Error(data?.errors?.[0]?.message || 'Submission failed');
            }
          } catch (err) {
            contactStatus.textContent = 'Something went wrong. Please try again later.';
            contactStatus.className = 'font-mono text-[12.5px] text-red-600';
          } finally {
            submitBtn.disabled = false;
          }
        });
      }
    });
  </script>

  <style>
    /* Ensure sections have proper spacing for navigation */
    section {
      scroll-margin-top: 80px;
    }
  </style>
</Layout>
